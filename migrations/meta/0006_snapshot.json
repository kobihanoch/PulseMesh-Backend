          "name": "incident_latitude_range",
          "value": "\"registry\".\"incident\".\"latitude\" BETWEEN -90 AND 90"
        },
        "incident_longitude_range": {
          "name": "incident_longitude_range",
          "value": "\"registry\".\"incident\".\"longitude\" BETWEEN -180 AND 180"
        },
        "incident_radius_positive": {
