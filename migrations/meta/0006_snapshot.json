          "value": "(\"registry\".\"incident\".\"status\" = 'active' AND \"registry\".\"incident\".\"closed_at\" IS NULL) OR (\"registry\".\"incident\".\"status\" <> 'active' AND \"registry\".\"incident\".\"closed_at\" IS NOT NULL)"
